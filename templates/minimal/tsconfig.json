{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022"],
    "types": ["bun", "react"],
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react"
  },
  "include": ["src"]
}
