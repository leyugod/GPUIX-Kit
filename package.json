{
  "name": "gpuix-kit-workspace",
  "version": "0.19.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun apps/gallery/src/main.tsx",
    "typecheck": "bun run --filter \"@mirai/*\" typecheck && tsc --noEmit -p tsconfig.tools.json",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "test": "vitest run",
    "test:ui": "bun tests/integration/uikit.tsx",
    "check": "bun run typecheck && bun run check:boundaries && bun run test",
    "pack": "bun run --filter @mirai/gpuix-kit pack",
    "test:ui:narrow": "bun tests/integration/uikit.tsx --narrow",
    "test:live": "bun tests/integration/live.ts",
    "test:package": "bun scripts/verify-package.ts",
    "dev:desktop": "bun apps/gallery/src/main.tsx --desktop",
    "test:desktop": "bun tests/integration/desktop.tsx",
    "test:desktop:narrow": "bun tests/integration/desktop.tsx --narrow",
    "test:desktop:states": "bun tests/integration/desktop-states.tsx",
    "test:live:desktop": "bun tests/integration/live.ts --desktop",
    "dev:workbench": "bun apps/gallery/src/main.tsx --workbench",
    "test:workbench": "bun tests/integration/workbench.tsx",
    "test:workbench:narrow": "bun tests/integration/workbench.tsx --narrow",
    "test:workbench:states": "bun tests/integration/workbench-states.tsx",
    "test:live:workbench": "bun tests/integration/live.ts --workbench",
    "dev:studio": "bun apps/gallery/src/main.tsx --studio",
    "test:studio": "bun tests/integration/studio.tsx",
    "test:studio:narrow": "bun tests/integration/studio.tsx --narrow",
    "test:studio:states": "bun tests/integration/studio-states.tsx",
    "test:live:studio": "bun tests/integration/live.ts --studio",
    "dev:controls": "bun apps/gallery/src/main.tsx --controls",
    "test:controls": "bun tests/integration/controls.tsx",
    "test:controls:narrow": "bun tests/integration/controls.tsx --narrow",
    "test:controls:states": "bun tests/integration/controls-states.tsx",
    "test:live:controls": "bun tests/integration/live.ts --controls",
    "dev:choices": "bun apps/gallery/src/main.tsx --choices",
    "test:choices": "bun tests/integration/choices.tsx",
    "test:choices:narrow": "bun tests/integration/choices.tsx --narrow",
    "test:choices:states": "bun tests/integration/choices-states.tsx",
    "test:live:choices": "bun tests/integration/live.ts --choices",
    "dev:time": "bun apps/gallery/src/main.tsx --time",
    "test:time": "bun tests/integration/time.tsx",
    "test:time:narrow": "bun tests/integration/time.tsx --narrow",
    "test:time:states": "bun tests/integration/time-states.tsx",
    "test:live:time": "bun tests/integration/live.ts --time",
    "dev:tracks": "bun apps/gallery/src/main.tsx --tracks",
    "test:tracks": "bun tests/integration/tracks.tsx",
    "test:tracks:narrow": "bun tests/integration/tracks.tsx --narrow",
    "test:tracks:states": "bun tests/integration/tracks-states.tsx",
    "test:live:tracks": "bun tests/integration/live.ts --tracks",
    "dev:dates": "bun apps/gallery/src/main.tsx --dates",
    "test:dates": "bun tests/integration/dates.tsx",
    "test:dates:narrow": "bun tests/integration/dates.tsx --narrow",
    "test:dates:states": "bun tests/integration/dates-states.tsx",
    "test:live:dates": "bun tests/integration/live.ts --dates",
    "dev:actions": "bun apps/gallery/src/main.tsx --actions",
    "test:actions": "bun tests/integration/actions.tsx",
    "test:actions:narrow": "bun tests/integration/actions.tsx --narrow",
    "test:actions:states": "bun tests/integration/actions-states.tsx",
    "test:live:actions": "bun tests/integration/live.ts --actions",
    "dev:colors": "bun apps/gallery/src/main.tsx --colors",
    "test:colors": "bun tests/integration/colors.tsx",
    "test:colors:narrow": "bun tests/integration/colors.tsx --narrow",
    "test:colors:states": "bun tests/integration/colors-states.tsx",
    "test:live:colors": "bun tests/integration/live.ts --colors",
    "dev:notifications": "bun apps/gallery/src/main.tsx --notifications",
    "test:notifications": "bun tests/integration/notifications.tsx",
    "test:notifications:narrow": "bun tests/integration/notifications.tsx --narrow",
    "test:notifications:states": "bun tests/integration/notifications-states.tsx",
    "test:live:notifications": "bun tests/integration/live.ts --notifications",
    "dev:tokens": "bun apps/gallery/src/main.tsx --tokens",
    "test:tokens": "bun tests/integration/tokens.tsx",
    "test:tokens:narrow": "bun tests/integration/tokens.tsx --narrow",
    "test:tokens:states": "bun tests/integration/tokens-states.tsx",
    "test:live:tokens": "bun tests/integration/live.ts --tokens",
    "dev:modals": "bun apps/gallery/src/main.tsx --modals",
    "test:modals": "bun tests/integration/modals.tsx",
    "test:modals:narrow": "bun tests/integration/modals.tsx --narrow",
    "test:modals:states": "bun tests/integration/modals-states.tsx",
    "test:live:modals": "bun tests/integration/live.ts --modals",
    "dev:sidebars": "bun apps/gallery/src/main.tsx --sidebars",
    "test:sidebars": "bun tests/integration/sidebars.tsx",
    "test:sidebars:narrow": "bun tests/integration/sidebars.tsx --narrow",
    "test:sidebars:states": "bun tests/integration/sidebars-states.tsx",
    "test:live:sidebars": "bun tests/integration/live.ts --sidebars",
    "dev:collections": "bun apps/gallery/src/main.tsx --collections",
    "test:collections": "bun tests/integration/collections.tsx",
    "test:collections:narrow": "bun tests/integration/collections.tsx --narrow",
    "test:collections:states": "bun tests/integration/collections-states.tsx",
    "test:live:collections": "bun tests/integration/live.ts --collections",
    "dev:filters": "bun apps/gallery/src/main.tsx --filters",
    "test:filters": "bun tests/integration/filters.tsx",
    "test:filters:narrow": "bun tests/integration/filters.tsx --narrow",
    "test:filters:states": "bun tests/integration/filters-states.tsx",
    "test:live:filters": "bun tests/integration/live.ts --filters",
    "dev:table-prefs": "bun apps/gallery/src/main.tsx --table-prefs",
    "test:table-prefs": "bun tests/integration/table-preferences.tsx",
    "test:table-prefs:narrow": "bun tests/integration/table-preferences.tsx --narrow",
    "test:table-prefs:states": "bun tests/integration/table-preferences-states.tsx",
    "test:live:table-prefs": "bun tests/integration/live.ts --table-prefs",
    "test:native:all": "bun scripts/test-native.ts",
    "check:release-source": "bun scripts/release-source.ts --check",
    "release:source": "bun run check:catalog && bun scripts/release-source.ts",
    "docs:api": "bun scripts/api-index.ts",
    "docs:api:check": "bun scripts/api-index.ts --check",
    "dev:catalog": "bun apps/gallery/src/main.tsx --catalog",
    "test:catalog": "bun tests/integration/catalog.tsx",
    "test:catalog:narrow": "bun tests/integration/catalog.tsx --narrow",
    "test:catalog:states": "bun tests/integration/catalog-states.tsx",
    "test:live:catalog": "bun tests/integration/live.ts --catalog",
    "check:catalog": "bun scripts/check-catalog.ts",
    "docs:catalog": "bun scripts/check-catalog.ts --write",
    "test:source": "bun run release:source && bun scripts/verify-source.ts",
    "test:input-alignment": "bun tests/integration/input-alignment.tsx"
  },
  "devDependencies": {
    "@gpuix/native": "0.7.0",
    "@gpuix/react": "0.7.0",
    "@mirai/gallery": "workspace:*",
    "@mirai/gpuix-kit": "workspace:*",
    "@types/bun": "1.3.5",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.14",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "prettier": "3.6.2",
    "react": "19.2.4",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
